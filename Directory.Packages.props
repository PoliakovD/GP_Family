<Project>

  <!-- Central Package Management: единственное место, где фиксируются версии пакетов на всё
       решение (src/ + tests/). Раньше версии были продублированы построчно по csproj — один и
       тот же пакет (например Microsoft.EntityFrameworkCore, MassTransit, Serilog.AspNetCore,
       Confluent.Kafka) фиксировался в 2-4 разных файлах вручную, и ничего не ловило расхождение,
       кроме дисциплины копирования (см. был явный комментарий об этом риске в
       FamilyHub.TelegramBot.csproj). Здесь — Version, в csproj — просто <PackageReference Include="X" />.
       Version НЕ указывается в csproj вообще, кроме случая явного override через VersionOverride
       (сейчас такого нет ни у одного пакета). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="EF Core / Postgres">
    <!-- Явная версия, совпадающая с Design/Npgsql, чтобы при транзитивном разрешении в
         зависимых проектах не подтягивалась более старая версия (у Npgsql.EntityFrameworkCore.
         PostgreSQL только нижняя граница диапазона). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <!-- Нужен и в startup-проекте (design-time сборка dotnet-ef), и в Infrastructure. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Событийная шина">
    <!-- 8.5.1 — последняя версия под Apache-2.0 (v9, апрель 2025, ушла на коммерческую лицензию —
         та же история, что и с MediatR). MassTransit.EntityFrameworkCore собран против EF Core
         9.0.1, но резолвится с нашим пиннингом 10.0.9 без конфликтов (см. ADR-0006). -->
    <PackageVersion Include="MassTransit" Version="9.2.3" />
    <PackageVersion Include="MassTransit.EntityFrameworkCore" Version="8.5.10" />
    <PackageVersion Include="MassTransit.Kafka" Version="9.2.3" />
    <!-- Явная версия (не только транзитивная через MassTransit.Kafka) — Confluent.Kafka.Admin
         используется напрямую для явного создания топиков при старте (ADR-0007), и в
         IntegrationTests для raw-проб-консьюмера (KafkaBridgeFlowTests). -->
    <PackageVersion Include="Confluent.Kafka" Version="2.16.0" />
  </ItemGroup>

  <ItemGroup Label="Фоновые задачи (Hangfire)">
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageVersion Include="Hangfire.Core" Version="1.8.25" />
    <PackageVersion Include="Hangfire.PostgreSql" Version="1.21.1" />
  </ItemGroup>

  <ItemGroup Label="Логирование">
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageVersion Include="Serilog.Exceptions" Version="8.4.0" />
    <PackageVersion Include="Serilog.Sinks.Seq" Version="9.1.0" />
  </ItemGroup>

  <ItemGroup Label="Почта / Push / Хранилище / Telegram">
    <PackageVersion Include="MailKit" Version="4.18.1" />
    <PackageVersion Include="AWSSDK.SimpleEmailV2" Version="4.0.105.1" />
    <PackageVersion Include="WebPush" Version="1.0.13" />
    <PackageVersion Include="Minio" Version="7.0.0" />
    <PackageVersion Include="Telegram.Bot" Version="22.10.3.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Документы / изображения (конвейер распознавания)">
    <!-- SkiaSharp — одна мажорная линия 3.119.x на всё решение: PDFtoImage 5.2.1 собран против
         SkiaSharp >= 3.119.2, NPOI 2.8.1 — против >= 3.119.4. На 4.x не поднимаем: PDFtoImage 5.3+
         (единственный, кто собран под 4.x) нам не нужен, а NPOI на 4.x не проверялся — принудительная
         унификация чужих уже скомпилированных сборок рискует MissingMethodException в рантайме.
         Явный пиннинг — чтобы версия не расползлась при добавлении пакета с более широким диапазоном. -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="PDFtoImage" Version="5.2.1" />
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
    <!-- 2.8.x больше не зависит от SixLabors.ImageSharp (перешёл на SkiaSharp). Бинарный релиз идёт
         под OSMF EULA (плата мейнтейнерам только при выручке >= $10k/год; исходники — Apache 2.0) —
         принято владельцем 2026-10-15, см. AcceptNPOIOSMFLicense в Directory.Build.props. -->
    <PackageVersion Include="NPOI" Version="2.8.1" />
    <!-- Фолбэк-декодер TIFF в ImageDownscaler (SkiaSharp TIFF не умеет). Заменил SixLabors.ImageSharp:
         у 2.x непатченные High-уязвимости (GHSA-j3p4-wp97-rph4, GHSA-j9gm-c75j-xc9q, GHSA-jjfr-hcj7-qf5w),
         а 4.x требует лицензионный ключ на этапе сборки. LibTiff.Net — управляемый порт libtiff, BSD. -->
    <PackageVersion Include="BitMiracle.LibTiff.NET" Version="2.4.660" />
  </ItemGroup>

  <ItemGroup Label="Swagger">
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup Label="Тесты">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="FluentAssertions" Version="6.12.2" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <!-- Клиент хаба чата семьи (ADR-0019) — только в интеграционных тестах; веб-клиент — npm @microsoft/signalr. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.12" />
    <!-- 3.10.0, не 4.x — совместимость между Testcontainers.PostgreSql/Minio/Kafka. -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="3.10.0" />
    <PackageVersion Include="Testcontainers.Minio" Version="3.10.0" />
    <PackageVersion Include="Testcontainers.Kafka" Version="3.10.0" />
  </ItemGroup>


  <ItemGroup Label="Транзитивные пины (закрытие уязвимых версий)">
    <!-- Newtonsoft.Json 11.0.1 (транзитивно через Hangfire.Core) — GHSA-5crp-9r3c-p9vr (DoS). -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- SQLitePCLRaw.lib.e_sqlite3 2.1.11 (транзитивно через Microsoft.Data.Sqlite, только тесты) — GHSA-2m69-gcr7-jv3q. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <!-- SSH.NET 2023.0.0 (транзитивно через Testcontainers, только тесты) — GHSA-q939-rpr3-3284. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <!-- System.Security.Cryptography.Pkcs 10.0.0 (транзитивно) — GHSA-846f-f764-76mx (High, DoS),
         GHSA-2fmv-rv2c-59x7. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
