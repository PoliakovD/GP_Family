# Реверс-прокси прод-контура (см. deploy/docker-compose.prod.yml и деплой-план, часть E).
# Домены и e-mail для Let's Encrypt читаются из .env (тот же файл, что деплой-workflow кладёт
# на VPS) — {$VAR} здесь читается из окружения ПРОЦЕССА caddy (env_file: .env в compose).
#
# Два класса сайтов:
#   1. Публичный (PUBLIC_DOMAIN, www) — 0.0.0.0:443, автоматический TLS через Let's Encrypt
#      (HTTP-01, порт 80 открыт). Единственная точка входа для реального трафика приложения.
#   2. Админский (Seq/MinIO Console/Hangfire/Swagger) — контейнерный порт :8443, который Docker
#      публикует ТОЛЬКО на WireGuard-адресе хоста (10.8.0.1:8443:8443, см. compose) — снаружи
#      недостижим в принципе, TLS — самоподписанный ("tls internal": Let's Encrypt не выдаст
#      сертификат на имя, которое резолвится в приватный 10.8.0.1 и не проходит HTTP-01).
#      Доступ: https://seq.<домен>:8443 и т.п. — ТОЛЬКО подключившись к WireGuard. Один раз
#      поставьте корневой CA Caddy на клиентскую машину (см. deploy/README.md), иначе браузер
#      будет ругаться на самоподписанный сертификат при каждом заходе.
{
	email {$ACME_EMAIL}
}

{$PUBLIC_DOMAIN}, www.{$PUBLIC_DOMAIN} {
	encode zstd gzip

	# Защита в глубину поверх DevTools-флагов (см. DevToolsOptions в FamilyHub.Api) и
	# InternalBotAuthFilter (см. /internal/* ниже): даже если один рубеж однажды сломают по
	# ошибке, эти пути с публичного домена всё равно не достучатся. /internal/* — контракт
	# FamilyHub.TelegramBot ↔ FamilyHub.Api (ADR-0008), снаружи не нужен вообще никому.
	@blocked path /dev/* /hangfire* /swagger* /health/* /internal/*
	handle @blocked {
		respond 404
	}

	# Вебхук Telegram обслуживает отдельный контейнер бота (ADR-0008), не api. Имя wg-client, а
	# не telegrambot: бот делит сетевой namespace с WG-сайдкаром (network_mode: service:wg-client,
	# см. docker-compose.prod.yml) и своего имени в compose-сети не имеет — порт 8080 биндится в
	# netns wg-client.
	handle /bot/webhook {
		reverse_proxy wg-client:8080
	}

	handle {
		reverse_proxy api:8080
	}
}

seq.{$PUBLIC_DOMAIN}:8443, s3.{$PUBLIC_DOMAIN}:8443, admin.{$PUBLIC_DOMAIN}:8443, bot.{$PUBLIC_DOMAIN}:8443 {
	tls internal

	@seq host seq.{$PUBLIC_DOMAIN}
	handle @seq {
		reverse_proxy seq:80
	}

	@s3 host s3.{$PUBLIC_DOMAIN}
	handle @s3 {
		# 9001 — MinIO Console (веб-UI), не 9000 (S3 API) — вложения и так идут через
		# HMAC-подписанный эндпоинт приложения (см. research/infrastructure.md), а не
		# напрямую из MinIO; консоль нужна только администратору для отладки бакета.
		reverse_proxy minio:9001
	}

	@admin host admin.{$PUBLIC_DOMAIN}
	handle @admin {
		# Hangfire (/hangfire) и Swagger (/swagger) на этом же api — за DevTools:AdminUiEnabled
		# и собственным BasicAuth-фильтром приложения (HangfireBasicAuthFilter/AdminBasicAuth,
		# см. Program.cs); WireGuard здесь — периметр, не единственный рубеж.
		reverse_proxy api:8080
	}

	# /health/ready и /health/telegram бота (ADR-0008) — только для ручной диагностики тоннеля
	# через WireGuard, без SSH. wg-client:8080 — тот же адрес, что и у публичного /bot/webhook
	# выше (сетевой namespace общий).
	@bot host bot.{$PUBLIC_DOMAIN}
	handle @bot {
		reverse_proxy wg-client:8080
	}

	handle {
		respond 404
	}
}
