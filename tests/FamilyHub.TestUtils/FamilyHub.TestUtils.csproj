<Project Sdk="Microsoft.NET.Sdk">

  <!-- Не тестовый проект сам по себе (нет тест-раннера), но наследует TargetFramework/Nullable
       от ../Directory.Build.props; IsTestProject/IsPackable там же выставлены — переопределяем,
       чтобы dotnet test не пытался запускать его как тестовый контейнер. -->
  <PropertyGroup>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FamilyHub.Domain\FamilyHub.Domain.csproj" />
    <ProjectReference Include="..\..\src\FamilyHub.Infrastructure\FamilyHub.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
