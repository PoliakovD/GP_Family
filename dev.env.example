# dev.env.example — шаблон ТОЛЬКО для локального docker-compose.yml (тестирование фич на
# машине разработчика). Использование:
#   cp dev.env.example .env
#   # заполните все CHANGE_ME (генераторы — в комментариях рядом с каждым)
#   docker compose up -d          # или .\dev.ps1 dev / make dev
#
# Файл называется dev.env.example, но копируется именно в .env — так его читает и docker
# compose (implicit .env), и env_file: .env у сервисов api/web в docker-compose.yml; отдельное
# имя dev.env потребовало бы --env-file на каждой команде, не стоит того для локали.
#
# Для прод-деплоя (VPS, GitHub Actions) используется ДРУГОЙ, более полный набор переменных —
# см. .env.example (полный, с комментариями по каждому разделу) и deploy/README.md. Секции
# "VPS-деплой"/"Telegram-бот на VPS" туда НЕ включены — этому файлу они не нужны вообще.

# ─── Docker Compose ────────────────────────────────────────────────────────────
# Префикс имён контейнеров/сети/volume'ов. Нужен, чтобы несколько git worktree на одной машине
# не топтали друг друга (см. scripts/worktree.ps1/.sh) — без него именем проекта служит имя
# каталога, и второй worktree со своим .env получил бы ОДИНАКОВЫЕ volume'ы (данные смешались бы).
# Если тестируете фичу в отдельном worktree — смените на что-то вроде familyhub-featurename.
COMPOSE_PROJECT_NAME=familyhub

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=familyhub
POSTGRES_PORT=5432

# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=5433
MINIO_CONSOLE_PORT=5434
# Нужны только при запуске api из IDE вне докера (appsettings.Development.json указывает
# Minio:Endpoint=localhost:5433, но не креды). Для контейнерного api берутся из
# MINIO_ROOT_USER/PASSWORD выше — эти две строки можно не трогать, если всегда через docker compose.
Minio__AccessKey=minioadmin
Minio__SecretKey=minioadmin

# ─── Seq (http://localhost:${SEQ_PORT}) ────────────────────────────────────────
SEQ_PORT=5341
SEQ_NO_AUTH=true

# ─── Kafka (ADR-0006/ADR-0007) ──────────────────────────────────────────────────
# Порт на хосте для отладки kafka-console-consumer.sh снаружи контейнера.
KAFKA_HOST_PORT=9094
# true — бизнес-потребители подписаны на Kafka Rider (как в проде); false — dev-lite без
# брокера, потребители на InMemory (быстрее поднимается, сообщения между сервисами доставляются
# синхронно в процессе). Для тестирования фич, завязанных на события (шаринг записей, выход из
# семьи, оповещения), проще оставить true — ближе к реальному поведению.
KAFKA_ENABLED=true

# ─── Web (Angular dev server) — http://localhost:${WEB_PORT} ──────────────────
WEB_PORT=80
# Порт api на хосте (для swagger/отладки напрямую, минуя web-прокси).
API_PORT=5276

# ─── Telegram Mini App (опционально — не нужен, если тестируете только PWA) ───
# Оставьте CHANGE_ME, если бот вам сейчас не нужен: TelegramInitDataValidator просто не будет
# использоваться, PWA-вход (email+пароль) и Dev-заглушка (см. DevTools ниже) работают без этого.
Telegram__BotToken=CHANGE_ME
Telegram__WebhookSecret=CHANGE_ME
Telegram__WebhookUrl=
Telegram__MiniAppUrl=https://your-ngrok-or-domain.example.com
# Секрет, которым telegrambot (профиль "bot", `docker compose --profile bot up -d`) подтверждает
# себя api на /internal/bot/*. Не менее 32 символов (fail-fast). Генерация: openssl rand -hex 32
Internal__BotApiToken=CHANGE_ME
BOT_PORT=5277

# ─── JWT PWA-сессия ─────────────────────────────────────────────────────────────
# Ровно 32 байта в base64. Генерация: openssl rand -base64 32
Jwt__SigningKey=CHANGE_ME
# Ротация (ADR-0009) — для локального тестирования самой фичи ротации: оставьте закомментированным,
# пока не тестируете именно её. Тогда добавляете Jwt__ActiveKeyId=v2 + новый Jwt__SigningKey,
# СТАРЫЙ ключ сюда как отставной, `docker compose restart api` — сессии не рвутся.
# Jwt__ActiveKeyId=v1
# Jwt__PreviousSigningKeys__0__Id=v1
# Jwt__PreviousSigningKeys__0__Material=CHANGE_ME

# ─── At-rest шифрование ПДн (152-ФЗ) ────────────────────────────────────────────
# Ровно 32 байта в base64. Генерация: openssl rand -base64 32. Без неё `docker compose up`
# откажется стартовать api (fail-fast, см. Program.cs).
ENCRYPTION_MASTER_KEY=CHANGE_ME
# Ротация (ADR-0009) — та же логика, что у Jwt выше, но перешифровка данных фоновая
# (EncryptionRotationJob) — после смены ключа зайдите в /admin (см. ниже) и нажмите
# «Перешифровать», чтобы протестировать сам прогон, а не только чтение старых данных.
# Encryption__PreviousKeys__0__Id=v1
# Encryption__PreviousKeys__0__Material=CHANGE_ME

# ─── Email ──────────────────────────────────────────────────────────────────────
# Ни один канал не настроен — письма (коды регистрации/сброса пароля) уходят только в лог
# api-контейнера (`docker compose logs -f api` или Seq), реальная отправка не нужна для
# локального тестирования. Раскомментируйте один из блоков ниже, только если тестируете
# конкретно доставку писем.
# Email__PostboxApi__AccessKeyId=CHANGE_ME
# Email__PostboxApi__SecretAccessKey=CHANGE_ME
# Email__PostboxApi__Region=ru-central1
# Email__PostboxApi__ServiceUrl=https://postbox.cloud.yandex.net
# Email__PostboxApi__From=noreply@CHANGE_ME
# Email__PostboxApi__FromDisplayName=FamilyHub
Email__PublicSiteUrl=http://localhost

# ─── LM Studio: локальная модель (OCR/оцифровка + суммаризация справочника) ────
# host.docker.internal — LM Studio на хосте (не в контейнере), api достучится через Docker Desktop.
LmStudio__BaseUrl=http://host.docker.internal:1234
# Id модели ровно как в LM Studio (GET /v1/models). Оставьте CHANGE_ME, если не тестируете
# оцифровку по фото/распознавание документов — остальное приложение работает без LM Studio.
LmStudio__Model=CHANGE_ME
LmStudio__TimeoutSeconds=1000
LmStudio__Reasoning=none

# ─── Enrichment: внешний веб-поиск для обогащения справочника препаратов ───────
# Null — по умолчанию, наружу не уходит ни одного запроса, справочник наполняется только вручную.
# Провайдер Brave/Yandex — только если тестируете конкретно конвейер обогащения (ADR-0005).
Enrichment__Provider=Null
# Enrichment__ApiKey=CHANGE_ME
# Enrichment__FolderId=CHANGE_ME

# ─── Extraction: извлечение показателей анализов/заключений из вложений ────────
# Enabled=false — заглушка (NullMedicalDocumentExtractor), «Распознать» всегда вернёт Failed.
# Требует настроенный LmStudio__Model выше, чтобы реально что-то распознавать.
Extraction__Enabled=true

# ─── Web Push ────────────────────────────────────────────────────────────────────
# Не заданы — канал просто не регистрируется (не fail-fast, в отличие от Jwt/Encryption выше).
# WebPush__VapidPublicKey=CHANGE_ME
# WebPush__VapidPrivateKey=CHANGE_ME
# WebPush__Subject=mailto:dev@localhost

# ─── Прочее ──────────────────────────────────────────────────────────────────────
# Ключ подписи ссылок на скачивание вложений. Генерация: любая строка ≥32 символов.
Attachments__DownloadSigningKey=CHANGE_ME_min_32_chars

# ─── DevTools (см. DevToolsOptions в FamilyHub.Api) — для локали ВСЕ true ──────
# DevAuthEnabled — вход под любым TelegramId без пароля (заголовок X-Dev-TelegramId, см.
# telegram.service.ts/localStorage familyhub:devTgId) — самый быстрый способ тестировать фичи
# без настоящего Telegram-бота. DevEndpointsEnabled — /dev/trigger-reminder-scan,
# /dev/email-preview/{name} и т.п. AdminUiEnabled — Hangfire-дашборд (/hangfire) и Swagger
# (/swagger) на http://localhost:${API_PORT}.
DevTools__DevAuthEnabled=true
DevTools__DevEndpointsEnabled=true
DevTools__AdminUiEnabled=true
DevTools__AdminUser=admin
DevTools__AdminPassword=CHANGE_ME

# ─── Админ-панель (ADR-0009): статистика + ротация ключей ──────────────────────
# Локально — тот же api-контейнер и тот же порт, что и весь остальной SPA (нет отдельного
# домена/Caddy, как на проде): откройте http://localhost:${WEB_PORT}/admin/login.
Admin__Enabled=true
Admin__User=admin
Admin__Password=CHANGE_ME
