{
  // Encryption:MasterKey, Jwt:SigningKey, Attachments:DownloadSigningKey, Minio:AccessKey/SecretKey —
  // намеренно НЕ здесь. Секреты не хардкодятся даже для Development: задать через переменные
  // окружения (Encryption__MasterKey и т.д., см. .env.example — `openssl rand -base64 32`) или
  // dotnet user-secrets. Без них Program.cs падает при старте с понятной ошибкой (fail-fast).
  "Email": {
    "PublicSiteUrl": "http://localhost"
  },
  // Порт MinIO из docker-compose.yml (MINIO_API_PORT) — запуск API из IDE (не в докере) бьёт
  // в тот же MinIO, что и остальные контейнеры dev-окружения.
  "Minio": {
    "Endpoint": "localhost:5433"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Hangfire": "Warning"
      }
    }
  }
}
