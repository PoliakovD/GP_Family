{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Hangfire": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithExceptionDetails", "WithEnvironmentName", "WithMachineName" ],
    "Properties": {
      "Application": "FamilyHub.Api"
    }
  },
  "AllowedHosts": "*",
  "Telegram": {
    "MaxInitDataAge": "1.00:00:00",
    "BotUsername": "gp_familybot"
  },
  "Minio": {
    "Bucket": "familyhub",
    "UseSsl": false
  },
  "Notifications": {
    "ExpiryWarningDays": 30,
    "BirthdayWarningDays": 7,
    "Cron": "0 8 * * *"
  },
  "Email": {
    "PublicSiteUrl": "https://gp-family.ru"
  },
  // ADR-0007 (пересматривает часть ADR-0006): Enabled переключает, ГДЕ живут бизнес-потребители
  // событий — не просто "включает опциональное зеркало в Kafka". false (дефолт здесь, для IDE и
  // тестовых хостов) — потребители на InMemory, dev-lite режим без единого обращения к брокеру.
  // true (docker-compose.yml — Messaging__Kafka__Enabled/BootstrapServers в environment api) —
  // потребители на Kafka Rider, обязателен для реальной доставки бизнес-событий (готовность к
  // выносу модулей в микросервисы без переписывания потребителей).
  "Messaging": {
    "Kafka": {
      "Enabled": false,
      "BootstrapServers": ""
    }
  }
}
