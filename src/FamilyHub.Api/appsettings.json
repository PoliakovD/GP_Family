{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Hangfire": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithExceptionDetails", "WithEnvironmentName", "WithMachineName" ],
    "Properties": {
      "Application": "FamilyHub.Api"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=familyhub;Username=postgres;Password=postgres"
  },
  "Telegram": {
    "BotToken": "8845702141:AAGdQtqWCAh65v7-udlVYOKefdMmtjt13S4",
    "MaxInitDataAge": "1.00:00:00",
    "WebhookSecret": "8845702141:AAGdQtqWCAh65v7-udlVYOKefdMmtjt13S4",
    "WebhookUrl": "",
    "MiniAppUrl": "https://gp-family.ru/"
  },
  "LocalFileStorage": {
    "RootPath": "App_Data/uploads",
    "PublicBasePath": "/local-files",
    "SigningKey": "dev-local-storage-signing-key"
  },
  "FileStorage": {
    "Provider": "Local"
  },
  "Minio": {
    "Endpoint": "localhost:5433",
    "AccessKey": "",
    "SecretKey": "",
    "Bucket": "familyhub",
    "UseSsl": false
  },
  "Notifications": {
    "ExpiryWarningDays": 30,
    "BirthdayWarningDays": 7,
    "Cron": "0 8 * * *"
  }
}
