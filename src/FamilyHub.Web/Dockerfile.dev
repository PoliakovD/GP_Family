FROM node:22-alpine

WORKDIR /app

# Копируем только манифесты — Docker кэширует этот слой пока package-lock.json не изменится.
# npm ci: детерминированный (lockfile), не пишет в package.json, быстрее npm install.
COPY package.json package-lock.json ./
RUN npm ci

EXPOSE 5173

CMD ["/app/node_modules/.bin/ng", "serve", \
     "--host", "0.0.0.0", \
     "--port", "5173", \
     "--disable-host-check"]
