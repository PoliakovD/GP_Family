<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FamilyHub.Contracts\FamilyHub.Contracts.csproj" />
    <ProjectReference Include="..\FamilyHub.Domain\FamilyHub.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Явная версия EFCore, совпадающая с Design, чтобы при транзитивном разрешении
         в зависимых проектах (Modules.Medical, Api) не подтягивалась более старая версия
         из Npgsql.EntityFrameworkCore.PostgreSQL (у него только нижняя граница диапазона). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Отладка 2026-08-20: без явной конфигурации ASP.NET Core Data Protection хранит ключи в
         эфемерной файловой системе контейнера (~/.aspnet/DataProtection-Keys) — каждый
         перезапуск/редеплой api сбрасывает их, инвалидируя CSRF-токены (IAntiforgery, см.
         Program.cs) у всех активных сессий. PersistKeysToDbContext<AppDbContext> — тот же
         Postgres, что и всё остальное состояние приложения, автоматически попадает под уже
         настроенный ночной pg_dump (см. deploy/backup). -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.9" />
    <!-- 8.5.1 — последняя версия под Apache-2.0 (v9, апрель 2025, ушла на коммерческую лицензию —
         та же история, что и с MediatR). Подтверждено спайком: MassTransit.EntityFrameworkCore
         собран под EF Core 9.0.1, но NuGet резолвит наш пиннинг 10.0.9 без конфликтов (см.
         ADR-0006). Заменяет MediatR + собственный Postgres-outbox (Infrastructure/Outbox/, этап 1). -->
    <PackageReference Include="MassTransit" Version="8.5.1" />
    <PackageReference Include="MassTransit.EntityFrameworkCore" Version="8.5.1" />
    <PackageReference Include="MassTransit.Kafka" Version="8.5.1" />
    <!-- Явная ссылка (не только транзитивная через MassTransit.Kafka) — используем
         Confluent.Kafka.Admin напрямую для явного создания топиков при старте (ADR-0007):
         TopicEndpoint-потребители валят весь Kafka Rider при старте, если топик ещё не
         существует ("ReceiveTransport faulted") — auto.create.topics.enable не успевает
         сработать до первой попытки подписки, нужно создавать топики явно, не полагаться на него. -->
    <PackageReference Include="Confluent.Kafka" Version="2.11.0" />
    <!-- Telegram.Bot убран отсюда: единственный потребитель (ITelegramBotClient/SendMessage)
         теперь FamilyHub.TelegramBot, отдельный процесс без доступа к БД. Здесь остаётся только
         TelegramInitDataValidator (HMAC initData Mini App) — чистая криптография, без пакета. -->
    <!-- SMTP-отправка (задача 2.5): универсальный клиент вместо SDK конкретного вендора —
         российский провайдер задаётся конфигом (host/логин), без привязки в коде. -->
    <PackageReference Include="MailKit" Version="4.17.0" />
    <!-- Отладка 2026-08-19: исходящие SMTP-порты 587/465 оказались заблокированы и на VDS, и
         локально у разработчика (провайдерский блок, не наш код) — Yandex Cloud Postbox даёт
         SESv2-совместимый HTTPS API (порт 443, подтверждённо доступен), см.
         YandexPostboxApiEmailSender. SMTP (выше) остаётся как канал в CompositeEmailSender —
         вдруг у другого провайдера/сети 587 когда-то заработает. -->
    <PackageReference Include="AWSSDK.SimpleEmailV2" Version="4.0.102.3" />
    <!-- Web Push (VAPID + RFC8291-шифрование payload) — редизайн навигации, ADR-0004: реальная
         доставка PWA-пользователям, не только через Telegram-бота. -->
    <PackageReference Include="WebPush" Version="1.0.13" />
    <!-- JWT access-токен для PWA-сессии (access-в-cookie + refresh в БД, см. auth-uiux rework). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Реальный объектный стор (этап 2 п.9), реализует тот же IFileStorage, что и LocalFileStorage. -->
    <PackageReference Include="Minio" Version="7.0.0" />
    <!-- Фоновые задачи оповещений (этап 3 п.10). Хранилище заданий — та же Postgres БД. -->
    <PackageReference Include="Hangfire.Core" Version="1.8.23" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.21.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- ветка medicalrecords: декодирование вложений для OCR-конвейера анализов/выписок (Documents/) —
         текстовый слой PDF, рендер PDF-страниц без текстового слоя, офисные форматы, ресайз фото.
         SkiaSharp НЕ пиннится на последнюю 3.x намеренно: PDFtoImage 4.1.1 скомпилирован против
         SkiaSharp 2.88.8 (см. его .nuspec) — 3.x менял сигнатуры SKBitmap.Resize/SKImageInfo, и
         принудительная унификация на 3.x рисковала бы MissingMethodException в рантайме внутри
         чужой уже скомпилированной сборки. Явные PackageReference ниже на 2.88.8 фиксируют то,
         что и так резолвится транзитивно от PDFtoImage — чтобы версия не расползлась незаметно
         при будущем добавлении другого пакета с более широким диапазоном. -->
    <PackageReference Include="PdfPig" Version="0.1.11" />
    <PackageReference Include="PDFtoImage" Version="4.1.1" />
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.8" />
    <PackageReference Include="NPOI" Version="2.7.4" />
    <!-- Явный пиннинг: NPOI 2.7.4 транзитивно тянет SixLabors.ImageSharp 2.1.10, у которого
         известная DoS-уязвимость (NU1902, GHSA-rxmq-m78w-7wmc) — картинки из офисных файлов мы
         не извлекаем (нужен только текст), но версию всё равно поднимаем до патченной. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.0" />
  </ItemGroup>

  <!-- Authorization/Authentication-абстракции (IAuthorizationHandler, ClaimsPrincipal-расширения и т.п.)
       поставляются с shared framework ASP.NET Core, а не отдельным NuGet-пакетом. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Вёрстка HTML-писем — встроенные ресурсы (как Legal\*.html в FamilyHub.Api): шаблон
         жёстко связан со сборкой, отдельного деплоя/тома для него не нужно. Правка требует
         пересборки — на диске меняется, в процессе не отражается, пока не пересобрано. -->
    <EmbeddedResource Include="Email\Templates\*.html" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
