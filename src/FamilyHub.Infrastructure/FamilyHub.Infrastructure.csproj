<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FamilyHub.Contracts\FamilyHub.Contracts.csproj" />
    <ProjectReference Include="..\FamilyHub.Domain\FamilyHub.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Явная версия EFCore, совпадающая с Design, чтобы при транзитивном разрешении
         в зависимых проектах (Modules.Medical, Api) не подтягивалась более старая версия
         из Npgsql.EntityFrameworkCore.PostgreSQL (у него только нижняя граница диапазона). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- 8.5.1 — последняя версия под Apache-2.0 (v9, апрель 2025, ушла на коммерческую лицензию —
         та же история, что и с MediatR). Подтверждено спайком: MassTransit.EntityFrameworkCore
         собран под EF Core 9.0.1, но NuGet резолвит наш пиннинг 10.0.9 без конфликтов (см.
         ADR-0006). Заменяет MediatR + собственный Postgres-outbox (Infrastructure/Outbox/, этап 1). -->
    <PackageReference Include="MassTransit" Version="8.5.1" />
    <PackageReference Include="MassTransit.EntityFrameworkCore" Version="8.5.1" />
    <PackageReference Include="MassTransit.Kafka" Version="8.5.1" />
    <!-- Явная ссылка (не только транзитивная через MassTransit.Kafka) — используем
         Confluent.Kafka.Admin напрямую для явного создания топиков при старте (ADR-0007):
         TopicEndpoint-потребители валят весь Kafka Rider при старте, если топик ещё не
         существует ("ReceiveTransport faulted") — auto.create.topics.enable не успевает
         сработать до первой попытки подписки, нужно создавать топики явно, не полагаться на него. -->
    <PackageReference Include="Confluent.Kafka" Version="2.11.0" />
    <PackageReference Include="Telegram.Bot" Version="22.10.1" />
    <!-- SMTP-отправка (задача 2.5): универсальный клиент вместо SDK конкретного вендора —
         российский провайдер задаётся конфигом (host/логин), без привязки в коде. -->
    <PackageReference Include="MailKit" Version="4.17.0" />
    <!-- Web Push (VAPID + RFC8291-шифрование payload) — редизайн навигации, ADR-0004: реальная
         доставка PWA-пользователям, не только через Telegram-бота. -->
    <PackageReference Include="WebPush" Version="1.0.13" />
    <!-- JWT access-токен для PWA-сессии (access-в-cookie + refresh в БД, см. auth-uiux rework). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Реальный объектный стор (этап 2 п.9), реализует тот же IFileStorage, что и LocalFileStorage. -->
    <PackageReference Include="Minio" Version="7.0.0" />
    <!-- Фоновые задачи оповещений (этап 3 п.10). Хранилище заданий — та же Postgres БД. -->
    <PackageReference Include="Hangfire.Core" Version="1.8.23" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.21.1" />
  </ItemGroup>

  <!-- Authorization/Authentication-абстракции (IAuthorizationHandler, ClaimsPrincipal-расширения и т.п.)
       поставляются с shared framework ASP.NET Core, а не отдельным NuGet-пакетом. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Вёрстка HTML-писем — встроенные ресурсы (как Legal\*.html в FamilyHub.Api): шаблон
         жёстко связан со сборкой, отдельного деплоя/тома для него не нужно. Правка требует
         пересборки — на диске меняется, в процессе не отражается, пока не пересобрано. -->
    <EmbeddedResource Include="Email\Templates\*.html" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
