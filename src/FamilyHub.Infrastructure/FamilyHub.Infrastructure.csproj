<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FamilyHub.Contracts\FamilyHub.Contracts.csproj" />
    <ProjectReference Include="..\FamilyHub.Domain\FamilyHub.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Отладка 2026-08-20: без явной конфигурации ASP.NET Core Data Protection хранит ключи в
         эфемерной файловой системе контейнера (~/.aspnet/DataProtection-Keys) — каждый
         перезапуск/редеплой api сбрасывает их, инвалидируя CSRF-токены (IAntiforgery, см.
         Program.cs) у всех активных сессий. PersistKeysToDbContext<AppDbContext> — тот же
         Postgres, что и всё остальное состояние приложения, автоматически попадает под уже
         настроенный ночной pg_dump (см. deploy/backup). -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <!-- Заменяет MediatR + собственный Postgres-outbox (Infrastructure/Outbox/, этап 1) — версии
         пакета и рационале см. Directory.Packages.props. -->
    <PackageReference Include="MassTransit" />
    <PackageReference Include="MassTransit.EntityFrameworkCore" />
    <PackageReference Include="MassTransit.Kafka" />
    <PackageReference Include="Confluent.Kafka" />
    <!-- Telegram.Bot убран отсюда: единственный потребитель (ITelegramBotClient/SendMessage)
         теперь FamilyHub.TelegramBot, отдельный процесс без доступа к БД. Здесь остаётся только
         TelegramInitDataValidator (HMAC initData Mini App) — чистая криптография, без пакета. -->
    <!-- SMTP-отправка (задача 2.5): универсальный клиент вместо SDK конкретного вендора —
         российский провайдер задаётся конфигом (host/логин), без привязки в коде. -->
    <PackageReference Include="MailKit" />
    <!-- Отладка 2026-08-19: исходящие SMTP-порты 587/465 оказались заблокированы и на VDS, и
         локально у разработчика (провайдерский блок, не наш код) — Yandex Cloud Postbox даёт
         SESv2-совместимый HTTPS API (порт 443, подтверждённо доступен), см.
         YandexPostboxApiEmailSender. SMTP (выше) остаётся как канал в CompositeEmailSender —
         вдруг у другого провайдера/сети 587 когда-то заработает. -->
    <PackageReference Include="AWSSDK.SimpleEmailV2" />
    <!-- Web Push (VAPID + RFC8291-шифрование payload) — редизайн навигации, ADR-0004: реальная
         доставка PWA-пользователям, не только через Telegram-бота. -->
    <PackageReference Include="WebPush" />
    <!-- JWT access-токен для PWA-сессии (access-в-cookie + refresh в БД, см. auth-uiux rework). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <!-- Реальный объектный стор (этап 2 п.9), реализует тот же IFileStorage, что и LocalFileStorage. -->
    <PackageReference Include="Minio" />
    <!-- Фоновые задачи оповещений (этап 3 п.10). Хранилище заданий — та же Postgres БД. -->
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="Hangfire.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <!-- ветка medicalrecords: декодирование вложений для OCR-конвейера анализов/выписок (Documents/) —
         текстовый слой PDF, рендер PDF-страниц без текстового слоя, офисные форматы, ресайз фото.
         Версии и рационале пиннинга (SkiaSharp 2.88.8, NPOI/ImageSharp CVE) — см.
         Directory.Packages.props. -->
    <PackageReference Include="PdfPig" />
    <PackageReference Include="PDFtoImage" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="NPOI" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="System.Text.Encoding.CodePages" />
  </ItemGroup>

  <!-- Authorization/Authentication-абстракции (IAuthorizationHandler, ClaimsPrincipal-расширения и т.п.)
       поставляются с shared framework ASP.NET Core, а не отдельным NuGet-пакетом. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Вёрстка HTML-писем — встроенные ресурсы (как Legal\*.html в FamilyHub.Api): шаблон
         жёстко связан со сборкой, отдельного деплоя/тома для него не нужно. Правка требует
         пересборки — на диске меняется, в процессе не отражается, пока не пересобрано. -->
    <EmbeddedResource Include="Email\Templates\*.html" />
  </ItemGroup>

</Project>
