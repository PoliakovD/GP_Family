<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Только маркерные интерфейсы MediatR (INotification) — сама MediatR-реализация
         подключается в Infrastructure. Contracts остаётся максимально лёгкой сборкой,
         на которую могут ссылаться все модули, не тянув за собой шину целиком. -->
    <PackageReference Include="MediatR.Contracts" Version="2.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
