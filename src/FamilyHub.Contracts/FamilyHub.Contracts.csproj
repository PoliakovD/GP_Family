<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ни одного PackageReference: MassTransit не требует интерфейса/атрибута на сообщении —
       обычный record в референсящейся сборке уже валидное сообщение шины (маршрутизация по
       message URN, см. ADR-0006). Contracts остаётся максимально лёгкой сборкой, на которую
       могут ссылаться все модули, не тянув за собой шину целиком. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
