<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <!-- Единственная проектная ссылка: у бота нет БД (все команды — через IFamilyHubApiClient
         обратно в FamilyHub.Api, см. Api/), ссылка на Infrastructure затащила бы в образ
         EF/Npgsql/Minio/Hangfire/MailKit/WebPush, не нужные процессу без БД. -->
    <ProjectReference Include="..\FamilyHub.Contracts\FamilyHub.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Версии — Directory.Packages.props (Central Package Management), общий для всего решения:
         тот же пакет здесь и в FamilyHub.Api/FamilyHub.Infrastructure гарантированно одной
         версии, дрейф больше не зависит от дисциплины копирования. -->
    <PackageReference Include="Telegram.Bot" />
    <PackageReference Include="MassTransit" />
    <PackageReference Include="MassTransit.Kafka" />
    <!-- Явная ссылка (не только транзитивная через MassTransit.Kafka) — бот создаёт свой топик
         (telegram-outbound) идемпотентно при старте тем же приёмом, что и Api (ADR-0007). -->
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Exceptions" />
    <PackageReference Include="Serilog.Sinks.Seq" />
  </ItemGroup>

</Project>
