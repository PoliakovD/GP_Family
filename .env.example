# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=familyhub
POSTGRES_PORT=5432

# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=5433
MINIO_CONSOLE_PORT=5434
# Для API внутри docker-compose креды берутся из MINIO_ROOT_USER/PASSWORD выше (см. api.environment).
# Эти две переменные нужны только при запуске API из IDE вне докера (appsettings.Development.json
# указывает Minio:Endpoint=localhost:5433, но не креды — секреты не хардкодятся даже для Development).
Minio__AccessKey=minioadmin
Minio__SecretKey=minioadmin

# ─── Seq ──────────────────────────────────────────────────────────────────────
SEQ_PORT=5341
SEQ_NO_AUTH=true

# ─── Kafka (ADR-0006/ADR-0007: Rider — реальный транспорт для бизнес-потребителей событий) ──
# Порт на хосте для отладки kafka-console-consumer.sh снаружи контейнера (внутри docker-сети
# api всегда стучится на kafka:9092 — см. Messaging__Kafka__BootstrapServers ниже в api.environment).
KAFKA_HOST_PORT=9094
# false здесь означало бы dev-lite режим без брокера (потребители на InMemory, см. ADR-0007) —
# для полного стека не имеет смысла, оставлен true.
KAFKA_ENABLED=true
# Для запуска API из IDE вне docker-compose (api-сервис в контейнере сам берёт kafka:9092,
# см. docker-compose.yml) — тот же паттерн, что уже есть для Minio__AccessKey/SecretKey выше.
# false = dev-lite: бизнес-потребители на InMemory, а не на Kafka Rider (ADR-0007) — быстрый
# локальный запуск без брокера; закомментируйте и поставьте true, если нужна именно Kafka-топология.
Messaging__Kafka__Enabled=false
Messaging__Kafka__BootstrapServers=localhost:9094

# ─── Web (Angular dev server) ─────────────────────────────────────────────────
WEB_PORT=80
# Порт API на хосте (для swagger/отладки). Внутри Docker сервисы общаются напрямую.
API_PORT=5276

# ─── Telegram ─────────────────────────────────────────────────────────────────
Telegram__BotToken=CHANGE_ME
Telegram__WebhookSecret=CHANGE_ME
Telegram__WebhookUrl=
# URL, который Telegram открывает как Mini App (ngrok для dev, домен для prod)
Telegram__MiniAppUrl=https://your-ngrok-or-domain.example.com

# ─── JWT PWA-сессия (access-токен) ────────────────────────────────────────────
# Ровно 32 байта в base64. Генерация: openssl rand -base64 32
Jwt__SigningKey=CHANGE_ME

# ─── At-rest шифрование ПДн (152-ФЗ) ──────────────────────────────────────────
# Ровно 32 байта в base64. Генерация: openssl rand -base64 32
# Обязателен для docker-compose.yml (без дефолта — см. находку 09 аудита безопасности):
# без этой переменной `docker compose up` откажется стартовать.
ENCRYPTION_MASTER_KEY=CHANGE_ME

# ─── Email (задача 2.5): SMTP-провайдеры, failover по порядку ─────────────────
# Провайдер 0 — основной, 1 — резервный. Требование 2.1/2.5: только серверы в РФ
# (например, Yandex Cloud Postbox / Яндекс 360 / VK WorkMail / RuSender). Пусто (секция
# отсутствует целиком) — письма только в лог, см. LoggingEmailSender.
# Email__Providers__0__Name=primary
# Email__Providers__0__Host=CHANGE_ME
# Email__Providers__0__Port=587
# Email__Providers__0__UseStartTls=true
# Email__Providers__0__User=CHANGE_ME
# Email__Providers__0__Password=CHANGE_ME
# Email__Providers__0__From=noreply@CHANGE_ME
# Email__Providers__0__DailyLimit=500
# Абсолютный URL сайта для кнопки «Открыть FamilyHub» в письмах. Обязателен (валидируется на
# старте), когда заданы Email__Providers__* — иначе письма никуда не уходят и незачем.
Email__PublicSiteUrl=https://your-domain.example.com

# ─── LM Studio: локальная модель (OCR по фото + суммаризация для справочника) ─────────────────
# BaseUrl — адрес LM Studio. Значение по умолчанию здесь — для запуска через docker-compose
# (api в контейнере, LM Studio на хосте; host.docker.internal резолвится в хост через Docker
# Desktop). Если запускаете API вне Docker — поменяйте на http://localhost:1234.
LmStudio__BaseUrl=http://host.docker.internal:1234
# Model — id модели ровно как в LM Studio (GET /v1/models).
LmStudio__Model=CHANGE_ME
# TimeoutSeconds — локальный vision-инференс на нескольких фото не быстрый, а при более высоком
# уровне размышлений может занять заметно дольше (см. LmStudioOptions.TimeoutSeconds).
LmStudio__TimeoutSeconds=1000
# Reasoning — глубина размышлений модели: none (без рассуждений, быстрее всего, по умолчанию) |
# minimal | medium | maximum. Задаётся словесной инструкцией в системном промпте, а не
# API-параметром — ни один параметр LM Studio не даёт предсказуемого контроля на разных
# моделях (см. LmStudioOptions.Reasoning).
LmStudio__Reasoning=none

# ─── Enrichment (этап 4): внешний веб-поиск для обогащения справочника препаратов ────────────
# Провайдер: Null (по умолчанию — наружу не уходит ни одного запроса, справочник наполняется
# только вручную) | Brave | Yandex (см. ADR-0005). ApiKey обязателен, если Provider != Null
# (fail-fast на старте). LM Studio (LmStudio__BaseUrl выше) для этого не меняется — суммаризация
# найденного материала остаётся строго на локальной модели.
Enrichment__Provider=Null
# Enrichment__ApiKey=CHANGE_ME
# FolderId — обязателен именно для Yandex (Web Search API v2/gen/search требует folderId в теле
# каждого запроса; см. https://yandex.cloud/ru/docs/resource-manager/operations/folder/get-id).
# Enrichment__FolderId=CHANGE_ME

# ─── Прочее ───────────────────────────────────────────────────────────────────
# Ключ подписи ссылок на скачивание вложений (DownloadTokenService/AttachmentDownloadOptions).
Attachments__DownloadSigningKey=CHANGE_ME_min_32_chars

# ─── Безопасность: пороги и TTL (опционально — у всех есть безопасные дефолты в коде, см.
# ─── AuthRateLimitOptions/JwtOptions/EncryptionOptions/AttachmentDownloadOptions; раскомментируйте
# ─── только если конкретному окружению нужно другое значение). НЕ путать с CSP/Antiforgery-cookie
# ─── (SameSite/HttpOnly/CSP-директивы) — те намеренно захардкожены в Program.cs, а не вынесены
# ─── сюда: это фиксированные защитные решения аудита, а не среда-зависимая настройка, и через
# ─── .env их было бы слишком легко случайно ослабить.

# Rate limiting auth-эндпоинтов (аудит module-review-2026-08-02/02-*, находка 2). Интеграционные
# тесты сами поднимают/занижают эти пороги через конфиг тестового хоста — эти значения касаются
# только реального запуска.
# RateLimiting__AuthPermitLimit=10
# RateLimiting__AuthWindowSeconds=60
# RateLimiting__CodePermitLimit=3
# RateLimiting__CodeWindowSeconds=3600
# RateLimiting__RedeemPermitLimit=1
# RateLimiting__RedeemWindowSeconds=5

# JWT PWA-сессия: время жизни токенов и допуск на рассинхронизацию часов (сам ключ подписи —
# Jwt__SigningKey выше, это секрет и остаётся обязательным).
# Jwt__Issuer=FamilyHub
# Jwt__Audience=FamilyHub.Pwa
# Jwt__AccessTokenLifetime=00:15:00
# Jwt__RefreshTokenLifetime=14.00:00:00
# Jwt__ClockSkew=00:00:30

# Идентификатор активного ключа at-rest шифрования (пишется в префикс шифротекста, задел под
# ротацию ключей; сам ключ — ENCRYPTION_MASTER_KEY выше).
# Encryption__ActiveKeyId=v1

# Время жизни подписанной ссылки на скачивание вложения (DownloadTokenService).
# Attachments__UrlTtl=00:05:00
