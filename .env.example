# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=familyhub
POSTGRES_PORT=5432

# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=5433
MINIO_CONSOLE_PORT=5434

# ─── Seq ──────────────────────────────────────────────────────────────────────
SEQ_PORT=5341
SEQ_NO_AUTH=true

# ─── Web (Angular dev server) ─────────────────────────────────────────────────
WEB_PORT=80
# Порт API на хосте (для swagger/отладки). Внутри Docker сервисы общаются напрямую.
API_PORT=5276

# ─── Telegram ─────────────────────────────────────────────────────────────────
Telegram__BotToken=CHANGE_ME
Telegram__WebhookSecret=CHANGE_ME
Telegram__WebhookUrl=
# URL, который Telegram открывает как Mini App (ngrok для dev, домен для prod)
Telegram__MiniAppUrl=https://your-ngrok-or-domain.example.com

# ─── JWT PWA-сессия (access-токен) ────────────────────────────────────────────
# Ровно 32 байта в base64. Генерация: openssl rand -base64 32
Jwt__SigningKey=CHANGE_ME

# ─── At-rest шифрование ПДн (152-ФЗ) ──────────────────────────────────────────
# Ровно 32 байта в base64. Генерация: openssl rand -base64 32
# Обязателен для docker-compose.yml (без дефолта — см. находку 09 аудита безопасности):
# без этой переменной `docker compose up` откажется стартовать.
ENCRYPTION_MASTER_KEY=CHANGE_ME

# ─── Email (задача 2.5): SMTP-провайдеры, failover по порядку ─────────────────
# Провайдер 0 — основной, 1 — резервный. Требование 2.1/2.5: только серверы в РФ
# (например, Yandex Cloud Postbox / Яндекс 360 / VK WorkMail / RuSender). Пусто (секция
# отсутствует целиком) — письма только в лог, см. LoggingEmailSender.
# Email__Providers__0__Name=primary
# Email__Providers__0__Host=CHANGE_ME
# Email__Providers__0__Port=587
# Email__Providers__0__UseStartTls=true
# Email__Providers__0__User=CHANGE_ME
# Email__Providers__0__Password=CHANGE_ME
# Email__Providers__0__From=noreply@CHANGE_ME
# Email__Providers__0__DailyLimit=500
# Абсолютный URL сайта для кнопки «Открыть FamilyHub» в письмах. Обязателен (валидируется на
# старте), когда заданы Email__Providers__* — иначе письма никуда не уходят и незачем.
Email__PublicSiteUrl=https://your-domain.example.com

# ─── LM Studio: локальная модель (OCR по фото + суммаризация для справочника) ─────────────────
# Model — id модели ровно как в LM Studio (GET /v1/models).
LmStudio__Model=CHANGE_ME
# Reasoning — глубина размышлений модели: none (без рассуждений, быстрее всего, по умолчанию) |
# minimal | medium | maximum. Задаётся словесной инструкцией в системном промпте, а не
# API-параметром — ни один параметр LM Studio не даёт предсказуемого контроля на разных
# моделях (см. LmStudioOptions.Reasoning).
LmStudio__Reasoning=none

# ─── Enrichment (этап 4): внешний веб-поиск для обогащения справочника препаратов ────────────
# Провайдер: Null (по умолчанию — наружу не уходит ни одного запроса, справочник наполняется
# только вручную) | Brave | Yandex (см. ADR-0005). ApiKey обязателен, если Provider != Null
# (fail-fast на старте). LM Studio (LmStudio__BaseUrl выше) для этого не меняется — суммаризация
# найденного материала остаётся строго на локальной модели.
Enrichment__Provider=Null
# Enrichment__ApiKey=CHANGE_ME
# FolderId — обязателен именно для Yandex (Web Search API v2/gen/search требует folderId в теле
# каждого запроса; см. https://yandex.cloud/ru/docs/resource-manager/operations/folder/get-id).
# Enrichment__FolderId=CHANGE_ME

# ─── Прочее ───────────────────────────────────────────────────────────────────
# Ключ подписи ссылок на скачивание вложений (DownloadTokenService/AttachmentDownloadOptions).
Attachments__DownloadSigningKey=CHANGE_ME_min_32_chars
