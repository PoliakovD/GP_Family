# ─── Docker Compose ────────────────────────────────────────────────────────────
# Префикс имён контейнеров/сети/volume'ов. Читается docker compose автоматически из .env —
# нужен, чтобы несколько git worktree на одной машине не топтали друг друга (см. scripts/worktree.ps1
# и scripts/worktree.sh): без него именем проекта служит имя каталога, и второй worktree со своим
# .env получил бы ОДИНАКОВЫЕ с первым имена volume'ов (postgres-data и т.д.) — данные бы смешались.
COMPOSE_PROJECT_NAME=familyhub

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=familyhub
POSTGRES_PORT=5432

# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=5433
MINIO_CONSOLE_PORT=5434
# Для API внутри docker-compose креды берутся из MINIO_ROOT_USER/PASSWORD выше (см. api.environment).
# Эти две переменные нужны только при запуске API из IDE вне докера (appsettings.Development.json
# указывает Minio:Endpoint=localhost:5433, но не креды — секреты не хардкодятся даже для Development).
Minio__AccessKey=minioadmin
Minio__SecretKey=minioadmin

# ─── Seq ──────────────────────────────────────────────────────────────────────
SEQ_PORT=5341
SEQ_NO_AUTH=true

# ─── Kafka (ADR-0006/ADR-0007: Rider — реальный транспорт для бизнес-потребителей событий) ──
# Порт на хосте для отладки kafka-console-consumer.sh снаружи контейнера (внутри docker-сети
# api всегда стучится на kafka:9092 — см. Messaging__Kafka__BootstrapServers ниже в api.environment).
KAFKA_HOST_PORT=9094
# false здесь означало бы dev-lite режим без брокера (потребители на InMemory, см. ADR-0007) —
# для полного стека не имеет смысла, оставлен true.
KAFKA_ENABLED=true
# Для запуска API из IDE вне docker-compose (api-сервис в контейнере сам берёт kafka:9092,
# см. docker-compose.yml) — тот же паттерн, что уже есть для Minio__AccessKey/SecretKey выше.
# false = dev-lite: бизнес-потребители на InMemory, а не на Kafka Rider (ADR-0007) — быстрый
# локальный запуск без брокера; закомментируйте и поставьте true, если нужна именно Kafka-топология.
Messaging__Kafka__Enabled=false
Messaging__Kafka__BootstrapServers=localhost:9094

# ─── Web (Angular dev server) ─────────────────────────────────────────────────
WEB_PORT=80
# Порт API на хосте (для swagger/отладки). Внутри Docker сервисы общаются напрямую.
API_PORT=5276

# ─── Telegram (ADR-0008: бот — отдельный процесс FamilyHub.TelegramBot, профиль "bot" в ──────
# ─── docker-compose.yml; см. секцию "Внутренний API для бота" ниже) ───────────────────────────
# BotToken нужен ОБОИМ процессам: api использует его для проверки HMAC initData Mini App
# (TelegramInitDataValidator), telegrambot — для вызовов Bot API (SendMessage/SetWebhook).
Telegram__BotToken=CHANGE_ME
# WebhookSecret/WebhookUrl/MiniAppUrl читает ТОЛЬКО telegrambot (см. docker-compose.yml,
# сервис telegrambot) — api эти ключи больше не использует.
Telegram__WebhookSecret=CHANGE_ME
Telegram__WebhookUrl=
# URL, который Telegram открывает как Mini App (ngrok для dev, домен для prod)
Telegram__MiniAppUrl=https://your-ngrok-or-domain.example.com

# ─── Внутренний API для FamilyHub.TelegramBot (ADR-0008) ──────────────────────────────────────
# Секрет, которым telegrambot подтверждает себя api на /internal/bot/* (заголовок
# X-Internal-Token, см. InternalBotAuthFilter) — команды бота (/start, инвайты, привязка) идут
# этим путём, у бота нет доступа к БД. Не менее 32 символов (fail-fast в Program.cs).
# Генерация: openssl rand -hex 32
Internal__BotApiToken=CHANGE_ME
# Порт хоста для сервиса telegrambot (профиль "bot") — только для локальной отладки вебхука.
BOT_PORT=5277

# ─── JWT PWA-сессия (access-токен) ────────────────────────────────────────────
# Ровно 32 байта в base64. Генерация: openssl rand -base64 32
Jwt__SigningKey=CHANGE_ME
# Ротация ключа подписи (ADR-0009) — НЕ трогайте до реальной ротации. Процедура: сгенерировать
# новый ключ → он становится Jwt__SigningKey, а СТАРОЕ значение переезжает сюда как отставной
# (Id — произвольный ярлык для диагностики/kid, Material — сам старый ключ) → редеплой: уже
# выданные access-токены (живут Jwt__AccessTokenLifetime, по умолчанию 15 минут) продолжают
# проходить валидацию, новые подписываются уже новым ключом. Через несколько минут после
# редеплоя отставной ключ можно убрать — все токены, подписанные им, к этому моменту истекут.
# Jwt__ActiveKeyId=v1
# Jwt__PreviousSigningKeys__0__Id=v1
# Jwt__PreviousSigningKeys__0__Material=CHANGE_ME

# ─── At-rest шифрование ПДн (152-ФЗ) ──────────────────────────────────────────
# Ровно 32 байта в base64. Генерация: openssl rand -base64 32
# Обязателен для docker-compose.yml (без дефолта — см. находку 09 аудита безопасности):
# без этой переменной `docker compose up` откажется стартовать.
ENCRYPTION_MASTER_KEY=CHANGE_ME
# Ротация мастер-ключа (ADR-0009) — та же процедура, что у Jwt__PreviousSigningKeys выше, но
# отставной ключ убирается только после того, как админ-панель (/admin, вкладка «Ключи») покажет
# «0 значений и 0 блобов» на старом keyId — перешифровка данных фоновая и не мгновенная (кнопка
# «Перешифровать», EncryptionRotationJob), в отличие от JWT/download-ссылок с коротким TTL.
# Encryption__PreviousKeys__0__Id=v1
# Encryption__PreviousKeys__0__Material=CHANGE_ME

# ─── Email (задача 2.5, расширено 2026-08-19) ──────────────────────────────────
# Два независимых канала, оба опциональны — если задан хотя бы один, CompositeEmailSender
# пробует их по порядку (PostboxApi первым, Providers — резервный). Ни один не задан — письма
# только в лог, см. LoggingEmailSender.
#
# PostboxApi — HTTPS API Yandex Cloud Postbox (порт 443), см. YandexPostboxApiEmailSender.
# Отладка 2026-08-19: исходящие SMTP-порты 587/465 (см. Providers ниже) оказались заблокированы
# провайдером связи и на проде, и локально — 443 остаётся рабочим, поэтому этот канал теперь
# основной. AccessKeyId/SecretAccessKey — ОТДЕЛЬНЫЙ статический access-key Yandex Cloud
# (консоль → Service Accounts → выбрать/создать сервисный аккаунт → «Создать новый ключ» →
# «Статический ключ доступа», роль ses.editor или шире) — НЕ логин/пароль SMTP из Providers,
# те для HTTPS API не годятся.
# Email__PostboxApi__AccessKeyId=CHANGE_ME
# Email__PostboxApi__SecretAccessKey=CHANGE_ME
# Email__PostboxApi__Region=ru-central1
# Email__PostboxApi__ServiceUrl=https://postbox.cloud.yandex.net
# Email__PostboxApi__From=noreply@CHANGE_ME
# Email__PostboxApi__FromDisplayName=FamilyHub
#
# Providers — SMTP-провайдеры, failover по порядку (провайдер 0 — основной, 1 — резервный).
# Требование 2.1/2.5: только серверы в РФ (Yandex Cloud Postbox / Яндекс 360 / VK WorkMail /
# RuSender). Держим как резервный канал на случай, если блокировка портов 587/465 у вашего
# провайдера снимется или добавится провайдер на другой сети/порту.
# Email__Providers__0__Name=primary
# Email__Providers__0__Host=CHANGE_ME
# Email__Providers__0__Port=587
# Email__Providers__0__UseStartTls=true
# Email__Providers__0__User=CHANGE_ME
# Email__Providers__0__Password=CHANGE_ME
# Email__Providers__0__From=noreply@CHANGE_ME
# Email__Providers__0__DailyLimit=500
#
# Абсолютный URL сайта для кнопки «Открыть FamilyHub» в письмах. Обязателен (валидируется на
# старте), когда задан хотя бы один канал выше — иначе письма никуда не уходят и незачем.
Email__PublicSiteUrl=https://your-domain.example.com

# ─── LM Studio: локальная модель (OCR по фото + суммаризация для справочника) ─────────────────
# BaseUrl — адрес LM Studio. Значение по умолчанию здесь — для запуска через docker-compose
# (api в контейнере, LM Studio на хосте; host.docker.internal резолвится в хост через Docker
# Desktop). Если запускаете API вне Docker — поменяйте на http://localhost:1234.
LmStudio__BaseUrl=http://host.docker.internal:1234
# Model — id модели ровно как в LM Studio (GET /v1/models).
LmStudio__Model=CHANGE_ME
# TimeoutSeconds — локальный vision-инференс на нескольких фото не быстрый, а при более высоком
# уровне размышлений может занять заметно дольше (см. LmStudioOptions.TimeoutSeconds).
LmStudio__TimeoutSeconds=1000
# Reasoning — глубина размышлений модели: none (без рассуждений, быстрее всего, по умолчанию) |
# minimal | medium | maximum. Задаётся словесной инструкцией в системном промпте, а не
# API-параметром — ни один параметр LM Studio не даёт предсказуемого контроля на разных
# моделях (см. LmStudioOptions.Reasoning).
LmStudio__Reasoning=none

# ─── Enrichment (этап 4): внешний веб-поиск для обогащения справочника препаратов ────────────
# Провайдер: Null (по умолчанию — наружу не уходит ни одного запроса, справочник наполняется
# только вручную) | Brave | Yandex (см. ADR-0005). ApiKey обязателен, если Provider != Null
# (fail-fast на старте). LM Studio (LmStudio__BaseUrl выше) для этого не меняется — суммаризация
# найденного материала остаётся строго на локальной модели.
Enrichment__Provider=Null
# Enrichment__ApiKey=CHANGE_ME
# FolderId — обязателен именно для Yandex (Web Search API v2/gen/search требует folderId в теле
# каждого запроса; см. https://yandex.cloud/ru/docs/resource-manager/operations/folder/get-id).
# Enrichment__FolderId=CHANGE_ME

# ─── Extraction (ветка medicalrecords): конвейер извлечения показателей анализов и заключений
# ─── врача из вложений (OCR/текстовый разбор через LM Studio выше). Enabled=false — заглушка
# ─── (NullMedicalDocumentExtractor), «Распознать» всегда вернёт Failed. Остальные поля — только
# ─── если конкретному окружению нужно другое значение, у всех есть дефолты в ExtractionOptions.
Extraction__Enabled=true
# Extraction__MaxPages=10
# Extraction__MaxImageDimension=1600
# Extraction__JpegQuality=78
# Extraction__MaxCharsPerChunk=6000
# Extraction__RasterDpi=150

# ─── Web Push (ADR-0004): реальная доставка PWA-пользователям без Telegram ────────────────────
# Пара VAPID-ключей + контакт. Не заданы (любое пустое) — WebPushOptions.IsConfigured=false,
# канал просто не регистрируется (см. Program.cs) — не fail-fast, в отличие от Jwt/Encryption.
# Генерация: npx web-push generate-vapid-keys (или любая другая VAPID-библиотека).
# WebPush__VapidPublicKey=CHANGE_ME
# WebPush__VapidPrivateKey=CHANGE_ME
# WebPush__Subject=mailto:admin@your-domain.example.com

# ─── Прочее ───────────────────────────────────────────────────────────────────
# Ключ подписи ссылок на скачивание вложений (DownloadTokenService/AttachmentDownloadOptions).
Attachments__DownloadSigningKey=CHANGE_ME_min_32_chars
# Ротация (ADR-0009) — ссылки живут всего Attachments__UrlTtl (по умолчанию 5 минут), поэтому
# отставной ключ обычно можно убрать почти сразу после редеплоя, без ожидания панели. Без Id —
# просто перебирается связка целиком при проверке подписи (см. DownloadTokenService.Validate).
# Attachments__PreviousSigningKeys__0=CHANGE_ME_старый_ключ

# ─── Безопасность: пороги и TTL (опционально — у всех есть безопасные дефолты в коде, см.
# ─── AuthRateLimitOptions/JwtOptions/EncryptionOptions/AttachmentDownloadOptions; раскомментируйте
# ─── только если конкретному окружению нужно другое значение). НЕ путать с CSP/Antiforgery-cookie
# ─── (SameSite/HttpOnly/CSP-директивы) — те намеренно захардкожены в Program.cs, а не вынесены
# ─── сюда: это фиксированные защитные решения аудита, а не среда-зависимая настройка, и через
# ─── .env их было бы слишком легко случайно ослабить.

# Rate limiting auth-эндпоинтов (аудит module-review-2026-08-02/02-*, находка 2). Интеграционные
# тесты сами поднимают/занижают эти пороги через конфиг тестового хоста — эти значения касаются
# только реального запуска.
# RateLimiting__AuthPermitLimit=10
# RateLimiting__AuthWindowSeconds=60
# RateLimiting__CodePermitLimit=3
# RateLimiting__CodeWindowSeconds=3600
# RateLimiting__RedeemPermitLimit=1
# RateLimiting__RedeemWindowSeconds=5

# JWT PWA-сессия: время жизни токенов и допуск на рассинхронизацию часов (сам ключ подписи —
# Jwt__SigningKey выше, это секрет и остаётся обязательным).
# Jwt__Issuer=FamilyHub
# Jwt__Audience=FamilyHub.Pwa
# Jwt__AccessTokenLifetime=00:15:00
# Jwt__RefreshTokenLifetime=14.00:00:00
# Jwt__ClockSkew=00:00:30

# Идентификатор активного ключа at-rest шифрования (пишется в префикс шифротекста; сам ключ —
# ENCRYPTION_MASTER_KEY выше). Меняйте ВМЕСТЕ с ним при ротации (ADR-0009, см. блок выше) —
# иначе старое значение ActiveKeyId продолжит помечать новый ключ прежним keyId.
# Encryption__ActiveKeyId=v1

# Время жизни подписанной ссылки на скачивание вложения (DownloadTokenService).
# Attachments__UrlTtl=00:05:00

# ─── DevTools (см. DevToolsOptions в FamilyHub.Api) ───────────────────────────
# Hangfire-дашборд/Swagger/DevAuth/`/dev/*` больше НЕ гейтятся на ASPNETCORE_ENVIRONMENT — контур
# может быть Production по среде (нужен для DeveloperExceptionPage — см. деплой-план), но dev по
# инструментам. Локально (docker-compose.yml) — все три true. На VPS: AdminUiEnabled=true (за
# BasicAuth ниже + WireGuard-периметром Caddy), DevAuthEnabled=false, DevEndpointsEnabled=false.
DevTools__DevAuthEnabled=true
DevTools__DevEndpointsEnabled=true
DevTools__AdminUiEnabled=true
# Обязательны, если AdminUiEnabled=true (fail-fast на старте) — защищают /hangfire и /swagger
# поверх периметра. Генерация пароля: openssl rand -base64 24
DevTools__AdminUser=admin
DevTools__AdminPassword=CHANGE_ME

# ─── Админ-панель (ADR-0009): статистика + ротация ключей ─────────────────────────────────────
# Отдельная секция от DevTools:AdminUser/Password выше намеренно — это постоянная продуктовая
# поверхность (статистика, ротация ключа шифрования), а не служебный BasicAuth поверх Hangfire/
# Swagger, и её пароль должен ротироваться независимо. Живёт на admin.{PUBLIC_DOMAIN}:4059
# (см. deploy/Caddyfile), доступна только через WireGuard — тот же периметр, что и класс 2 выше.
# Enabled=false — эндпоинты /api/admin/* вообще не примапятся (см. Program.cs), сама схема
# аутентификации не регистрируется. Обязательны User/Password, если Enabled=true (fail-fast).
Admin__Enabled=false
# Генерация пароля: openssl rand -base64 24
Admin__User=admin
Admin__Password=CHANGE_ME
# Время жизни cookie сессии панели (абсолютное, без sliding-продления).
# Admin__SessionLifetime=12:00:00

# ─── VPS-деплой (см. deploy/docker-compose.prod.yml, deploy/Caddyfile, deploy/README.md) ──────
# Эти ключи не нужны локальному docker-compose.yml — только секрету PROD_ENV в GitHub Actions.
# IMAGE/IMAGE_TAG/IMAGE_BOT дописывает сам workflow deploy.yml перед выгрузкой .env на VPS —
# сюда их добавлять не нужно (и незачем: тег образа решает пайплайн, не секрет).
PUBLIC_DOMAIN=gp-family.ru
ACME_EMAIL=admin@gp-family.ru
# Хеш пароля администратора Seq (SEQ_FIRSTRUN_NOAUTHENTICATION=false на VPS — см. compose).
# Генерация: docker run --rm datalust/seq config hash <пароль>
SEQ_ADMIN_PASSWORD_HASH=CHANGE_ME

# ─── Telegram-бот на VPS (ADR-0008) — тоже только в секрете PROD_ENV ──────────────────────────
# ⚠️ Двойное написание одного и того же секрета намеренное (см. docker-compose.prod.yml):
# сервис api читает env_file: .env как Telegram__BotToken (двойное подчёркивание — ASP.NET
# Core), сервис telegrambot ссылается на TELEGRAM_BOT_TOKEN явным environment: (одиночное,
# читает Docker Compose при интерполяции ${...}). Один и тот же секрет — оба написания должны
# совпадать, иначе бот тихо стартует с пустым токеном и ничего не делает.
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME
TELEGRAM_WEBHOOK_URL=https://gp-family.ru/bot/webhook
TELEGRAM_MINIAPP_URL=https://gp-family.ru
# Тот же секрет, что Internal__BotApiToken выше — тоже в двух написаниях по той же причине.
INTERNAL_BOT_API_TOKEN=CHANGE_ME
# WG_IMAGE сюда добавлять НЕ нужно — деплой-workflow пишет его сам (собирается из исходников
# amneziawg-go/amneziawg-tools, см. deploy/wg/Dockerfile и .github/workflows/deploy.yml).
#
# Конфиг тоннеля (реальный, с настоящими ключами) — секрет WG_CONF, отдельно от PROD_ENV, целиком
# = содержимому awg0.conf (см. деплой-workflow, шаг "Render конфиг Amnezia WG"). НЕ добавляйте
# его сюда и не коммитьте — он не проходит через .env вообще, только через свой секрет.
#
# Включение бота на VPS: когда TELEGRAM_*/INTERNAL_BOT_API_TOKEN выше заданы реальными
# значениями и WG_CONF сохранён отдельным секретом — добавьте COMPOSE_PROFILES=bot сюда же,
# в PROD_ENV (см. комментарий в docker-compose.prod.yml).
# COMPOSE_PROFILES=bot
